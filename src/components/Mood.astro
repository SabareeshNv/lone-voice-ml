---
// A mood label. It always links to that mood's own page.
import { MOODS, moodHref, type MoodKey } from "../data/moods";

interface Props {
  mood: MoodKey;
}

const { mood } = Astro.props;
const m = MOODS[mood];
const href = moodHref(mood);
// Also true on the later pages of that mood ("/moods/curious/2/").
const here = Astro.url.pathname.startsWith(href);
---

<a class="mood" href={href} style={`--h: ${m.hue}`} aria-current={here ? "page" : undefined}><span class="vh">Mood:</span>{" "}{m.label}</a>

<style>
  .mood {
    display: inline-flex;
    align-items: center;
    padding: 0 0.7em 0.08em;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--mood-fill);
    color: var(--on-fill);
    font-size: 0.92em;
    font-weight: 700;
    line-height: 1.45;
    white-space: nowrap;
    text-decoration: none;
  }
  .mood:hover {
    translate: 0 -1px;
    box-shadow: 2px 3px 0 var(--ink);
  }
  /* On a mood's own page, that mood is shown inverted. */
  .mood[aria-current="page"] {
    background: var(--ink);
    color: var(--bg);
  }

  @media (forced-colors: active) {
    .mood {
      forced-color-adjust: none;
    }
  }
</style>
