---
// Newer / Older links under a paginated list. Shows nothing for a single page.
interface Props {
  current: number;
  last: number;
  newer?: string;
  older?: string;
  label: string;
}

const { current, last, newer, older, label } = Astro.props;
---

{
  last > 1 && (
    <nav class="pager" aria-label={label}>
      {newer ? (
        <a class="pager__link" href={newer} rel="prev">
          <span aria-hidden="true">←</span> Newer
        </a>
      ) : (
        <span></span>
      )}
      <p class="pager__where">
        Page {current} of {last}
      </p>
      {older ? (
        <a class="pager__link pager__link--older" href={older} rel="next">
          Older <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 3px solid var(--ink);
  }
  .pager__where {
    color: var(--ink-soft);
    font-weight: 700;
  }

  /* Outlined, with a hard shadow that closes on press. */
  .pager__link {
    display: inline-block;
    padding: 0.5rem 1.15rem 0.6rem;
    border: 3px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .pager__link:hover {
    translate: 2px 2px;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .pager__link--older {
    justify-self: end;
  }
  .pager__link:first-child {
    justify-self: start;
  }

  @media print {
    .pager {
      display: none;
    }
  }
</style>
