---
// The little drawn sticker for a mood. Decorative: the mood name is always
// written out in words beside it.
import { MOOD_ART, MOOD_ART_DEFAULT } from "../data/art";
import { MOODS, type MoodKey } from "../data/moods";

interface Props {
  mood: MoodKey;
  class?: string;
}

const { mood, class: className } = Astro.props;
const art = MOOD_ART[mood] ?? MOOD_ART_DEFAULT;
---

<span class:list={["glyph", className]} style={`--h: ${MOODS[mood].hue}`} aria-hidden="true">
  <svg viewBox="0 0 64 64" focusable="false" set:html={art}></svg>
</span>

<style>
  /* Pages size and place the sticker through the class they pass in (see the
     .entry__badge, .essay__badge, .mood-hero__badge and .mood-sheet rules). */
  .glyph {
    display: inline-grid;
    place-items: center;
    flex: none;
    background: var(--mood-fill);
    border: 3px solid var(--ink);
    border-radius: 50%;
  }
  .glyph svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The drawing (from src/data/art.ts) is set with set:html, so it is outside the
     component's scope. Lines are always near-black and fills white, so it reads on
     any mood colour in either theme. */
  .glyph :global(.f),
  .glyph :global(.k),
  .glyph :global(.kf) {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph :global(.f) {
    fill: #fff;
  }
  .glyph :global(.k) {
    fill: none;
    stroke: #12121a;
    stroke-width: 3;
  }
  .glyph :global(.f.k) {
    fill: #fff;
  }
  .glyph :global(.kf) {
    fill: #12121a;
  }

  @media (forced-colors: active) {
    .glyph {
      forced-color-adjust: none;
    }
  }
</style>
