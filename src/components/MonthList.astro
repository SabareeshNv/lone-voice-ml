---
// Posts grouped by month, hanging off the thread. Used by the home page and
// by every mood page.
import { isEssay, type MonthGroup } from "../lib/posts";
import EssayEntry from "./EssayEntry.astro";
import ScribbleEntry from "./ScribbleEntry.astro";

interface Props {
  months: MonthGroup[];
}

const { months } = Astro.props;
---

{
  months.map((m) => (
    <section class="month" aria-labelledby={`m-${m.key}`}>
      <h2 class="month__label" id={`m-${m.key}`}>
        <span class="month__name">{m.month}</span>{" "}
        <span class="month__year">{m.year}</span>
      </h2>
      <ol class="month__entries" role="list">
        {m.posts.map((post) => (
          <li>{isEssay(post) ? <EssayEntry post={post} /> : <ScribbleEntry post={post} />}</li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .month + .month {
    margin-block-start: 3.5rem;
  }
  .month__label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block-end: 1.25rem;
  }
  .month__name {
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .month__year {
    padding: 0.1em 0.6em 0.18em;
    border-radius: 0.4rem;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.3;
    rotate: -3deg;
  }

  /* The thread itself: one heavy line, with a sticker hung on it for every post. */
  .month__entries {
    list-style: none;
    margin: 0;
    padding: 0;
    border-inline-start: var(--line) solid var(--accent);
    display: grid;
    row-gap: 0.5rem;
  }

  /* On a phone there is no side column, so the stickers hung on the thread would reach
     past the screen's edge. Move the thread in by about half a sticker (plus its hover size). */
  @media (max-width: 59.999rem) {
    .month__entries {
      margin-inline-start: 1.5rem;
    }
  }
</style>
